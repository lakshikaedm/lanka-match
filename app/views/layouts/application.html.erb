<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Sith & Soul" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1, viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps if needed later %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= favicon_link_tag "sith_soul_logo.png", type: "image/png" %>

    <%= tag.link rel: "apple-touch-icon",
                 href: asset_path("sith_soul_logo.png") %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div data-controller="confirm-modal">
      <div class="app">
        <div class="app-container">
          <%= render "shared/navbar" %>
          <%= render "shared/flash" %>

          <main class="main-content">
            <%= yield %>
          </main>
        </div>
      </div>
      <%= render "shared/confirm_modal" %>
    </div>
  </body>
</html>
