<div style="max-width:600px;margin:40px auto;padding:32px;background:#ffffff;border:1px solid #e5e5e5;border-radius:12px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#333333;line-height:1.6;">

  <h1 style="margin:0 0 24px;font-size:28px;font-weight:700;color:#222222;">
    Reset your password
  </h1>

  <p style="margin:0 0 16px;">
    Hello <strong><%= @resource.email %></strong>,
  </p>

  <p style="margin:0 0 24px;">
    We received a request to reset the password for your <strong>Lanka Match</strong> account.
  </p>

  <div style="margin:32px 0;text-align:center;">
    <%= link_to "Reset Password",
      edit_password_url(@resource, reset_password_token: @token),
      style: "display:inline-block;padding:14px 28px;background:#d94d68;color:#ffffff;text-decoration:none;border-radius:8px;font-weight:600;font-size:16px;" %>
  </div>

  <p style="margin:0 0 16px;">
    If you didn't request a password reset, you can safely ignore this email.
  </p>

  <p style="margin:0;color:#777777;font-size:14px;">
    Your password will not change until you open the link above and choose a new password.
  </p>

</div>
