<div class="browse-page">
  <% if @profiles.any? %>
    <div class="profile-grid">
      <% @profiles.each do |profile| %>
        <article class="public-profile-card public-profile-card--<%= profile.gender %>">
          <%= link_to public_profile_path(profile),
                      class: "public-profile-card__link" do %>

            <div class="public-profile-card__photo">
              <span>Photo</span>
            </div>

            <div class="public-profile-card__content">
              <h2 class="public-profile-card__name">
                <%= profile.display_name %>
              </h2>

              <p class="public-profile-card__meta">
                <span><%= profile.age %></span>

                <% if profile.location.present? %>
                  <span>·</span>
                  <span><%= profile.location %></span>
                <% end %>
              </p>
            </div>
          <% end %>

          <% if user_signed_in? && current_user != profile.user %>
            <div class="public-profile-card__actions">
              <% if @liked_user_ids.include?(profile.user_id) %>
                <%= button_to "Unlike",
                              public_profile_like_path(profile),
                              method: :delete,
                              class: "button button--secondary button--full" %>
              <% else %>
                <%= button_to "Like",
                              public_profile_like_path(profile),
                              method: :post,
                              class: "button button--primary button--full" %>
              <% end %>
            </div>
          <% end %>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="browse-empty">No profiles available yet.</p>
  <% end %>
</div>
