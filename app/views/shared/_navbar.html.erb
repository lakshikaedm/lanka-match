<header class="top-navbar">
  <div class="top-navbar__inner">
    <%= link_to public_profiles_path, class: "top-navbar__brand" do %>
      <div class="top-navbar__logo">
        <span>Logo</span>
      </div>

      <span class="top-navbar__title">
        LankaMatch
      </span>
    <% end %>
  </div>
</header>

<nav class="bottom-nav">
  <div class="bottom-nav__inner">

    <%= link_to public_profiles_path,
                class: "bottom-nav__item #{'bottom-nav__item--active' if current_page?(public_profiles_path)}" do %>
      <span class="bottom-nav__icon">⌂</span>
      <span class="bottom-nav__label">Browse</span>
    <% end %>

    <% if user_signed_in? %>
      <%= link_to conversations_path,
                  class: "bottom-nav__item #{'bottom-nav__item--active' if current_page?(conversations_path)}" do %>
        <span class="bottom-nav__icon">✉</span>
        <span class="bottom-nav__label">Chats</span>
      <% end %>

      <% if current_user.profile.present? %>
        <%= link_to profile_path,
                    class: "bottom-nav__item #{'bottom-nav__item--active' if current_page?(profile_path) || current_page?(edit_profile_path)}" do %>
          <span class="bottom-nav__icon">●</span>
          <span class="bottom-nav__label">Profile</span>
        <% end %>
      <% else %>
        <%= link_to new_profile_path,
                    class: "bottom-nav__item #{'bottom-nav__item--active' if current_page?(new_profile_path)}" do %>
          <span class="bottom-nav__icon">＋</span>
          <span class="bottom-nav__label">Profile</span>
        <% end %>
      <% end %>

      <%= link_to destroy_user_session_path,
                  data: { turbo_method: :delete },
                  class: "bottom-nav__item bottom-nav__item--logout" do %>
        <span class="bottom-nav__icon">↪</span>
        <span class="bottom-nav__label">Logout</span>
      <% end %>

    <% else %>
      <%= link_to new_user_registration_path,
                  class: "bottom-nav__item #{'bottom-nav__item--active' if current_page?(new_user_registration_path)}" do %>
        <span class="bottom-nav__icon">＋</span>
        <span class="bottom-nav__label">Sign up</span>
      <% end %>

      <%= link_to new_user_session_path,
                  class: "bottom-nav__item #{'bottom-nav__item--active' if current_page?(new_user_session_path)}" do %>
        <span class="bottom-nav__icon">→</span>
        <span class="bottom-nav__label">Log in</span>
      <% end %>
    <% end %>

  </div>
</nav>
