<% flash.each do |type, message| %>
  <% next if message.blank? %>

  <% css_class =
       case type.to_sym
       when :notice
         "notice"
       when :success
         "success"
       when :alert, :error
         "error"
       when :warning
         "warning"
       else
         "notice"
       end %>

  <% auto_dismiss = %w[notice success].include?(css_class) %>

  <div class="flash-message flash-message--<%= css_class %>"
    data-controller="flash"
    data-flash-auto-dismiss-value="<%= auto_dismiss %>"
  >
    <div class="flash-message__content">
      <%= message %>
    </div>

    <button type="button"
      class="flash-message_close"
      data-action="flash#dismiss"
      aria-label="Dismiss notification"
    >
      x
    </button>
  </div>
<% end %>
