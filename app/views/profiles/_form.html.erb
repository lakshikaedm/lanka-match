<%= form_with model: @profile, url: profile_path do |form| %>
  <% if @profile.errors.any? %>
    <div class="form-errors">
      <h2 class="form-errors__title">
        <%= pluralize(@profile.errors.count, "error") %> prevented this profile from being saved. 
      </h2>
      <ul class="form-errors__list">
        <% @profile.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :display_name, class: "form-label" %>
    <%= form.text_field :display_name, class: "form-input", placeholder: "John Smith" %>
  </div>

  <div class="form-group">
    <%= form.label :birth_date, class: "form-label" %>
    <%= form.date_field :birth_date, class: "form-input" %>
  </div>

  <div class="form-group">
    <%= form.label :gender, class: "form-label" %>
    <%= form.select :gender, Profile.genders.keys.map { |key| [key.humanize, key] }, prompt: "Select gender", class: "form-input form-select" %>
  </div>

  <div class="form-group">
    <%= form.label :location, class: "form-label" %>
    <%= form.text_field :location, class: "form-input", placeholder: "Colombo" %>
  </div>

  <div class="form-group">
    <%= form.label :bio, class: "form-label" %>
    <%= form.text_area :bio, class: "form-input", placeholder: "Tell something about yourself..." %>
  </div>

  <div class="form-group">
    <%= form.label :occupation, class: "form-label" %>
    <%= form.text_field :occupation, class: "form-input", placeholder: "Sales Manager" %>
  </div>

  <div class="form-actions">
    <%= form.submit class: "button button--primary button--full" %>
  </div>
<% end %>
