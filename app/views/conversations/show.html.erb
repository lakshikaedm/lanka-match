<h1>Conversations</h1>

<div>
  <% @messages.each do |message| %>
    <div>
      <strong><%= message.sender.email %></strong>
      <p><%= message.body %></p>
      <small><%= message.created_at.strftime("%Y-%m-%d %H:%M") %></small>
    </div>

    <hr>
  <% end %>
</div>

<%= form_with model: [@conversation, @message], local: true do |f| %>
  <div>
    <%= f.text_area :body, rows: 3 %>
  </div>

  <%= f.submit "Send" %>
<% end %>
